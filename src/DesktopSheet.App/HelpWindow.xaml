<Window x:Class="DesktopSheet.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="단축키" Width="380" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#8D96A3" BorderThickness="1" Background="White">
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#EFF1F4" BorderBrush="#D0D4DA" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <DockPanel>
                    <TextBlock Text="단축키" Margin="10,0,0,0" FontSize="11" Foreground="#586070"
                               VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Width="24" Height="24"
                            FontSize="11" Focusable="False" BorderThickness="0"
                            Background="Transparent" Foreground="#586070" Click="Close_Click" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" Margin="0,4,0,8" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
